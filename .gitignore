# Logs — the app writes to %AppData%\OAuthProxy\logs, but keep stray local ones out too
*.log

# Local secrets / state.
# The real credential store is DPAPI-encrypted at %AppData%\OAuthProxy\store.dat and is
# never inside the repo, but this guards against a copy ever being dropped here.
*.dat
local.settings.json

# OS
.DS_Store
Thumbs.db

