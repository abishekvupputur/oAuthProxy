<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net8.0-windows\publish\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <!--
      Compresses the embedded assemblies: ~243 MB down to ~99 MB. This is for the exe published
      as a release asset and downloaded directly, where the size is what a person waits for. It
      costs a slower first start, since the payload is extracted to temp before the app runs.

      The release workflow deliberately overrides this to false for a second publish, whose only
      consumer is the installer. LZMA2 cannot improve on an already-deflated blob, so compressing
      this exe again yielded a 101.6 MB installer — over the 100 MB limit GitHub enforces on files
      committed to a repository, which the Microsoft Store submission depends on because it needs
      a redirect-free raw.githubusercontent.com URL. Given the raw payload instead, the installer
      comes out at 67.9 MB. See installer/RavensPort.iss and docs/STORE-SUBMISSION.md.
    -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
</Project>
