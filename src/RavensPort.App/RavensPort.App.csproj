<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- TargetFramework comes from Directory.Build.props — see the note there on why it is shared. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\tray.ico</ApplicationIcon>
    <AssemblyName>RavensPort</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\tray.ico" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\proton-pass-logo.png" />
    <Resource Include="..\RavensPort.Core\Assets\logo.png" Link="Assets\ravensport-mark.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\OnePasswordNative\onepassword.dll">
      <Link>onepassword.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RavensPort.Core\RavensPort.Core.csproj" />
  </ItemGroup>

</Project>
