<UserControl x:Class="OAuthProxy.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:OAuthProxy.App.Helpers"
             mc:Ignorable="d" d:DesignWidth="480"
             Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      helpers:SmoothScroll.Enable="True" Padding="0,0,4,0">
            <StackPanel Margin="16">
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Listen port" Style="{StaticResource SectionHeaderStyle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBox Width="100" Text="{Binding ListenPort, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Save" Margin="8,0,0,0" Width="70" Command="{Binding SavePortCommand}"/>
                    </StackPanel>
                    <TextBlock Text="Changing the port requires restarting OAuthProxy." Style="{StaticResource HintTextStyle}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Local API key" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,8" TextWrapping="Wrap"
                               Text="Every proxied request must send this as the 'X-Proxy-Key' header (or a 'proxy_key' query parameter for clients that cannot set headers). Without it the proxy would attach your OAuth tokens for any program on this machine that knows the port."/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBox Width="290" IsReadOnly="True" FontFamily="Cascadia Code, Consolas" FontSize="11"
                                 Text="{Binding LocalApiKeyDisplay, Mode=OneWay}"/>
                        <Button Content="Show" Margin="8,0,0,0" Width="60"
                                Command="{Binding ToggleApiKeyVisibilityCommand}"/>
                        <Button Content="Copy" Margin="6,0,0,0" Width="60" Command="{Binding CopyApiKeyCommand}"/>
                    </StackPanel>

                    <Button Content="Regenerate key" HorizontalAlignment="Left" Width="130"
                            Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding RegenerateApiKeyCommand}"/>
                    <TextBlock Text="Regenerating immediately breaks any client still using the old key."
                               Style="{StaticResource HintTextStyle}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}"/>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel>
                    <TextBlock Text="Recent activity" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Text="Last 20 lines — proxied requests, token refreshes, route reloads. Updates every 2s."
                               Style="{StaticResource HintTextStyle}" Margin="0,0,0,8"/>

                    <Border Background="#151515" BorderBrush="{StaticResource BorderBrush0}" BorderThickness="1"
                            CornerRadius="4" Padding="8" Margin="0,0,0,10">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="220">
                            <TextBox Text="{Binding RecentActivity, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="Cascadia Code, Consolas" FontSize="11"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     Foreground="{StaticResource TextBrush}"
                                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Disabled"/>
                        </ScrollViewer>
                    </Border>

                    <WrapPanel>
                        <Button Content="Open activity log" Margin="0,0,8,6" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding OpenActivityLogCommand}"/>
                        <Button Content="Open error log" Margin="0,0,8,6" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding OpenErrorLogCommand}"/>
                        <Button Content="Open log folder" Margin="0,0,8,6" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding OpenLogFolderCommand}"/>
                        <Button Content="Prune old logs" Margin="0,0,0,6" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding PruneLogsCommand}"/>
                    </WrapPanel>

                    <TextBlock Text="Logs rotate automatically every 2 days; files older than ~10 days are deleted. Prune removes all rotated logs and the error log, keeping the current one."
                               Style="{StaticResource HintTextStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Pinned footer: status stays visible instead of scrolling out of view. -->
        <Border Grid.Row="1" Style="{StaticResource FooterBarStyle}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource FooterTextStyle}"/>
        </Border>
    </Grid>
</UserControl>
