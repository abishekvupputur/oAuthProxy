<Window x:Class="OAuthProxy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:OAuthProxy.App.Views"
        mc:Ignorable="d"
        Title="OAuthProxy" Height="688" Width="892" MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        TextElement.FontFamily="Segoe UI">
    <!--
        Two whole-window states rather than a banner over a disabled UI: without a reachable
        password manager there is no configuration at all, so the tabs would be four empty grids
        whose every control fails. A Grid with visibility rather than a ContentControl with a
        state DataTemplate, because the code-behind wires the tab views up by x:Name and a
        template would rebuild them out from under it.
    -->
    <Grid>
        <views:SetupView x:Name="SetupViewControl"
                         Visibility="{Binding IsGated, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <TabControl x:Name="TabsControl" SelectionChanged="TabControl_SelectionChanged"
                    Visibility="{Binding IsNormal, Converter={StaticResource BoolToVisibilityConverter}}">
            <TabItem Header="Credentials">
                <views:CredentialsView x:Name="CredentialsViewControl"/>
            </TabItem>
            <TabItem Header="Routes">
                <views:RoutesView x:Name="RoutesViewControl"/>
            </TabItem>
            <TabItem Header="MCP Funnel">
                <views:McpFunnelView x:Name="McpFunnelViewControl"/>
            </TabItem>
            <TabItem Header="Settings">
                <views:SettingsView x:Name="SettingsViewControl"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
