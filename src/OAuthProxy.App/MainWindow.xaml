<Window x:Class="OAuthProxy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:OAuthProxy.App.Views"
        mc:Ignorable="d"
        Title="OAuthProxy" Height="640" Width="860" MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        TextElement.FontFamily="Segoe UI">
    <TabControl SelectionChanged="TabControl_SelectionChanged">
        <TabItem Header="Credentials">
            <views:CredentialsView x:Name="CredentialsViewControl"/>
        </TabItem>
        <TabItem Header="Routes">
            <views:RoutesView x:Name="RoutesViewControl"/>
        </TabItem>
        <TabItem Header="Settings">
            <views:SettingsView x:Name="SettingsViewControl"/>
        </TabItem>
    </TabControl>
</Window>
